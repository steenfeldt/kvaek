# Copy to .env.prod on the server. Never commit .env.prod.
DJANGO_SECRET_KEY=            # e.g. output of: openssl rand -base64 48
POSTGRES_PASSWORD=            # e.g. output of: openssl rand -hex 24
EMAIL_HOST_PASSWORD=          # Resend API key (re_...)
DEFAULT_FROM_EMAIL=Kvæk <noreply@kvaek.com>
MOLLIE_API_KEY=               # test_... until live
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Invoice seller identity — fill when the ApS is registered
INVOICE_SELLER_NAME=Kvæk (under stiftelse)
INVOICE_SELLER_CVR=
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_EMAIL=noreply@kvaek.com
